HOST=0.0.0.0
PORT=1337
NODE_ENV=production

# Generate strong random keys for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=replace_with_random_string
ADMIN_JWT_SECRET=replace_with_random_string
TRANSFER_TOKEN_SALT=replace_with_random_string
JWT_SECRET=replace_with_random_string

# ── MySQL database (from Cloudways dashboard) ─────────────
DATABASE_CLIENT=mysql
DATABASE_HOST=your-cloudways-db-host
DATABASE_PORT=3306
DATABASE_NAME=your_db_name
DATABASE_USERNAME=your_db_user
DATABASE_PASSWORD=your_db_password
DATABASE_SSL=false

# ── SMTP Email ────────────────────────────────────────────
SMTP_HOST=mail.focusspace.co.za
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@focusspace.co.za
SMTP_PASS=your_smtp_password
SMTP_FROM=Focus Conference <info@focusspace.co.za>
SMTP_REPLY_TO=focusconference@mut.ac.za

# ── App URLs (set to your real domain) ───────────────────
FRONTEND_URL=https://your-domain.com

# ── Brevo Newsletter ──────────────────────────────────────
BREVO_API_KEY=your_brevo_api_key
BREVO_LIST_ID=2
