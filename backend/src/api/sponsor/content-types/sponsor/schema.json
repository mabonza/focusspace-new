{
  "kind": "collectionType",
  "collectionName": "sponsors",
  "info": {
    "singularName": "sponsor",
    "pluralName": "sponsors",
    "displayName": "Sponsor"
  },
  "options": { "draftAndPublish": false },
  "pluginOptions": {},
  "attributes": {
    "name": { "type": "string", "required": true },
    "logo": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "website": { "type": "string" },
    "tier": {
      "type": "enumeration",
      "enum": ["platinum", "gold", "silver", "bronze", "partner"],
      "default": "bronze"
    },
    "conference": {
      "type": "relation", "relation": "manyToOne",
      "target": "api::conference.conference", "inversedBy": "sponsors"
    }
  }
}
