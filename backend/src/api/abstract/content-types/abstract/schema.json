{
  "kind": "collectionType",
  "collectionName": "abstracts",
  "info": {
    "singularName": "abstract",
    "pluralName": "abstracts",
    "displayName": "Abstract"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "abstractText": {
      "type": "text",
      "required": true
    },
    "keywords": {
      "type": "string"
    },
    "subtheme": {
      "type": "string"
    },
    "coAuthors": {
      "type": "string"
    },
    "institution": {
      "type": "string"
    },
    "documentUpload": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["files"]
    },
    "status": {
      "type": "enumeration",
      "enum": ["draft", "submitted", "under-review", "revision-requested", "accepted", "rejected"],
      "default": "draft",
      "required": true
    },
    "presentationType": {
      "type": "enumeration",
      "enum": ["oral", "poster", "workshop", "virtual"],
      "default": "oral"
    },
    "reviewerComments": {
      "type": "text"
    },
    "adminComments": {
      "type": "text"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "conference": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::conference.conference"
    },
    "assignedReviewer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "reviews": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::review.review",
      "mappedBy": "abstract"
    }
  }
}
