{
  "kind": "collectionType",
  "collectionName": "conferences",
  "info": {
    "singularName": "conference",
    "pluralName": "conferences",
    "displayName": "Conference",
    "description": "Academic conferences managed by Focus Space"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "title": { "type": "string", "required": true, "minLength": 2 },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "year": { "type": "integer" },
    "theme": { "type": "string" },
    "description": { "type": "richtext" },
    "startDate": { "type": "date" },
    "endDate": { "type": "date" },
    "venue": { "type": "string" },
    "location": { "type": "string" },
    "heroImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "bannerImage": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "status": {
      "type": "enumeration",
      "enum": ["draft", "upcoming", "active", "completed", "archived"],
      "default": "draft"
    },
    "featured": { "type": "boolean", "default": false },
    "registrationOpen": { "type": "boolean", "default": false },
    "abstractSubmissionOpen": { "type": "boolean", "default": false },
    "registrationUrl": { "type": "string" },
    "hostedBy": { "type": "string" },
    "preconferenceStartDate": { "type": "date" },
    "preconferenceEndDate": { "type": "date" },
    "backgroundContext": { "type": "richtext" },
    "contactEmail": { "type": "email" },
    "contactPhone": { "type": "string" },
    "contactAddress": { "type": "text" },
    "conferenceFee": { "type": "decimal" },
    "preconferenceFee": { "type": "decimal" },
    "subThemes": { "type": "json" },
    "importantDates": { "type": "json" },
    "events": {
      "type": "relation", "relation": "oneToMany",
      "target": "api::event.event", "mappedBy": "conference"
    },
    "speakers": {
      "type": "relation", "relation": "oneToMany",
      "target": "api::speaker.speaker", "mappedBy": "conference"
    },
    "programmeSessions": {
      "type": "relation", "relation": "oneToMany",
      "target": "api::programme-session.programme-session", "mappedBy": "conference"
    },
    "sponsors": {
      "type": "relation", "relation": "oneToMany",
      "target": "api::sponsor.sponsor", "mappedBy": "conference"
    },
    "publications": {
      "type": "relation", "relation": "oneToMany",
      "target": "api::publication.publication", "mappedBy": "conference"
    }
  }
}
