{
  "kind": "collectionType",
  "collectionName": "speakers",
  "info": {
    "singularName": "speaker",
    "pluralName": "speakers",
    "displayName": "Speaker"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "name": { "type": "string", "required": true },
    "title": { "type": "string" },
    "organisation": { "type": "string" },
    "bio": { "type": "text" },
    "photo": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "role": {
      "type": "enumeration",
      "enum": ["host", "keynote", "speaker", "panelist", "reviewer"],
      "default": "speaker"
    },
    "conference": {
      "type": "relation", "relation": "manyToOne",
      "target": "api::conference.conference", "inversedBy": "speakers"
    }
  }
}
