# Environment files — NEVER commit these
.env
.env.local
.env.production
backend/.env
frontend/.env
frontend/.env.local

# Dependencies
node_modules/
**/node_modules/

# Build output (frontend only)
frontend/dist/
frontend/build/
.output/

# Strapi cache only (dist is committed so server skips the build)
backend/.cache/
backend/.tmp/
backend/.strapi/

# Docker volumes (local data)
*.sqlite
*.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
